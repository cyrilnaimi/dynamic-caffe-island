    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Automatic uses the notch on displays that have one and a floating pill below the menu bar elsewhere. When hidden, point at the top centre of the screen to open it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique utilise l’encoche sur les écrans qui en ont une, et une pastille flottante sous la barre des menus ailleurs. Une fois masquée, pointez en haut au centre de l’écran pour l’ouvrir."
          }
        }
      }
    },
    "Battery": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie"
          }
        }
      }
    },
    "Battery at %lld%%. Your Mac can sleep": {
      "comment": "Toast when the battery guard stops a session; %lld is the battery percentage.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie à %lld %%. Votre Mac peut dormir"
          }
        }
      }
    },
    "Brewing… awake %@": {
      "comment": "Toast when a session starts. %@ = “for 30 min” / “until 19:45” / “until you stop it”.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça infuse… éveillé %@"
          }
        }
      }
    },
