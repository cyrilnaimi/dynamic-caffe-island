{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ finished. Your Mac can sleep": {
      "comment": "Toast when the watched app/command exits; %@ is its name (“Xcode”, “make”).",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est terminé. Votre Mac peut dormir"
          }
        }
      }
    },
    "%@ isn’t running": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas ouvert"
          }
        }
      }
    },
    "%@ remaining": {
      "comment": "VoiceOver label of the big countdown; %@ is a duration like “12 min”.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restantes"
